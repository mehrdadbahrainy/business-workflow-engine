{
  "realm": "flowforge",
  "displayName": "Flowforge (local quickstart)",
  "enabled": true,
  "sslRequired": "none",
  "registrationAllowed": true,
  "registrationEmailAsUsername": false,
  "resetPasswordAllowed": false,
  "rememberMe": true,
  "verifyEmail": false,
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "roles": {
    "realm": [
      { "name": "workflow-admin", "description": "Create and publish workflows and configure service connections" },
      { "name": "manager", "description": "Approve purchase requests" },
      { "name": "team-lead", "description": "Approve short employee leave" },
      { "name": "department-manager", "description": "Approve extended employee leave" },
      { "name": "hr", "description": "Handle HR work items" }
    ]
  },
  "clients": [
    {
      "clientId": "flowforge-web",
      "name": "Flowforge local SPA",
      "description": "Public PKCE-only browser client for localhost:8080",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": true,
      "bearerOnly": false,
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "fullScopeAllowed": true,
      "redirectUris": ["http://localhost:8080/auth/callback"],
      "webOrigins": ["http://localhost:8080"],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "http://localhost:8080/*"
      },
      "protocolMappers": [
        {
          "name": "flowforge-api-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.custom.audience": "business-workflow-engine",
            "access.token.claim": "true",
            "id.token.claim": "false"
          }
        },
        {
          "name": "flowforge-roles",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-realm-role-mapper",
          "consentRequired": false,
          "config": {
            "claim.name": "role",
            "jsonType.label": "String",
            "multivalued": "true",
            "access.token.claim": "true",
            "id.token.claim": "false",
            "userinfo.token.claim": "true"
          }
        }
      ]
    }
  ],
  "users": [
    {
      "username": "flowadmin",
      "email": "flowadmin@example.test",
      "firstName": "Flowforge",
      "lastName": "Admin",
      "enabled": true,
      "emailVerified": true,
      "realmRoles": ["workflow-admin", "manager"],
      "credentials": [
        { "type": "password", "value": "DevOnly123!", "temporary": false }
      ],
      "requiredActions": []
    },
    {
      "username": "requester",
      "email": "requester@example.test",
      "firstName": "Demo",
      "lastName": "Requester",
      "enabled": true,
      "emailVerified": true,
      "realmRoles": [],
      "credentials": [
        { "type": "password", "value": "DevOnly123!", "temporary": false }
      ],
      "requiredActions": []
    },
    {
      "username": "teamlead",
      "email": "teamlead@example.test",
      "firstName": "Demo",
      "lastName": "Team Lead",
      "enabled": true,
      "emailVerified": true,
      "realmRoles": ["team-lead"],
      "credentials": [
        { "type": "password", "value": "DevOnly123!", "temporary": false }
      ],
      "requiredActions": []
    }
  ]
}
