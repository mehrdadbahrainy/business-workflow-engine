<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.12" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.12" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.12">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.3" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\..\examples\purchase-approval\definition.json" Link="Definitions\purchase-approval-v1.json" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\..\examples\purchase-approval\workflow.json" Link="Definitions\purchase-approval-workflow-v1.json" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\..\examples\employee-leave\workflow.json" Link="Definitions\employee-leave-workflow-v1.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
